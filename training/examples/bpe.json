{
  "model": {
    "dModel": 96,
    "nHeads": 4,
    "nLayers": 3,
    "blockSize": 128,
    "tieWeights": true
  },
  "tokenizer": {
    "type": "bpe",
    "vocabSize": 512
  },
  "training": {
    "batchSize": 8,
    "lr": 0.0005,
    "minLr": 0.00005,
    "weightDecay": 0.01,
    "gradClip": 1.0,
    "warmup": 50,
    "maxSteps": 1000,
    "logEvery": 10,
    "evalInterval": 100,
    "evalBatches": 10,
    "checkpointInterval": 250,
    "checkpointDir": "training/checkpoints",
    "valSplit": 0.1
  },
  "data": "training/datasets/sample.txt",
  "out": "models/tinyai-bpe.genai"
}
