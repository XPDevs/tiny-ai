{
  "model": {
    "dModel": 64,
    "nHeads": 4,
    "nLayers": 2,
    "blockSize": 64,
    "tieWeights": true
  },
  "tokenizer": {
    "type": "char",
    "vocabSize": 512
  },
  "training": {
    "batchSize": 4,
    "lr": 0.001,
    "minLr": 0.0001,
    "weightDecay": 0.01,
    "gradClip": 1.0,
    "warmup": 20,
    "maxSteps": 400,
    "logEvery": 10,
    "evalInterval": 50,
    "evalBatches": 5,
    "checkpointInterval": 100,
    "checkpointDir": "training/checkpoints",
    "valSplit": 0.1
  },
  "data": "training/datasets/sample.txt",
  "out": "models/tinyai-tiny.genai"
}
